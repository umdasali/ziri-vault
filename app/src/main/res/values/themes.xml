<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by the system while the app process starts (Android 12+ native splash, backported by core-splashscreen). -->
    <style name="Theme.KryptSafe.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KryptSafe</item>
    </style>

    <style name="Theme.KryptSafe" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
